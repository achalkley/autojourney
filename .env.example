# Environment configuration for AutoJourney
# Copy this file to .env and fill in your values

# ── LM Studio (local vision model) ──────────────────────────────────────────
# Base URL of the LM Studio local server
LM_STUDIO_BASE_URL=http://localhost:1234/v1
# Name of the loaded vision-capable model (as shown in LM Studio)
LM_STUDIO_MODEL=llava-llama-3-v-vision

# ── Cloud LLM fallback (optional) ───────────────────────────────────────────
# Set LLM_PROVIDER to "openai" or "anthropic" to override LM Studio
# LLM_PROVIDER=lmstudio
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Figma ────────────────────────────────────────────────────────────────────
# Personal access token with write scope for the target Figma file
FIGMA_API_TOKEN=
# Figma file key (from the URL: figma.com/file/<FILE_KEY>/...)
FIGMA_FILE_KEY=
# Name of the Figma page to create (will be created if it doesn't exist)
FIGMA_PAGE_NAME=AutoJourney

# ── Capture ──────────────────────────────────────────────────────────────────
# Output directory for raw frames and processed assets
OUTPUT_DIR=./output

# ── Event detection tuning ───────────────────────────────────────────────────
# SSIM drop below this threshold signals a screen transition (0–1)
TRANSITION_SSIM_THRESHOLD=0.70
# Minimum fraction of frame area that must change to count as a transition
TRANSITION_AREA_FRACTION=0.15
# Optical flow magnitude threshold for scroll detection
SCROLL_FLOW_THRESHOLD=3.0
